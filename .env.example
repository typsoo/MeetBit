# Neon connection string. Copy this file to .env and fill in your values.
# Integration tests use a separate Neon branch (see ticket 01).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:8081
BETTER_AUTH_SECRET=
# Google OAuth client (Web application).
# Authorized redirect URI: http://localhost:8081/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
